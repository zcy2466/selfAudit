# SelfAudit environment configuration
# Copy this file to .env and fill in your values

# LLM Configuration (backbone model for TPA, ERA, IA)
LLM_MODEL=gpt-4o
LLM_API_KEY=your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0

# Heterogeneous verifier (SRA uses a different model)
HETEROGENEOUS_LLM_MODEL=qwen2.5-7b-instruct
HETEROGENEOUS_LLM_API_KEY=your-qwen-api-key
HETEROGENEOUS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=your-openai-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Reranker Configuration
RERANK_MODEL=bge-reranker-large
RERANK_BASE_URL=http://localhost:9997/v1/rerank

# HCD-EA Parameters
HCD_TAU=0.75
HCD_K=3
HCD_ALPHA=0.5

# ERA Retrieval Parameters
ERA_TOPK=10

# Backbone models for cross-model robustness experiment
BACKBONE_LIST=["gpt-4o","qwen2.5-72b-instruct","llama-3.3-70b-instruct","deepseek-v3"]

# Paths
DATASET_PATH=./data
RESULTS_PATH=./results

# Misc
RANDOM_SEED=42